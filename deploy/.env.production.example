# CPS — preprod environment variables
# Copy to /opt/cps/.env.production and fill in real secrets.
# DO NOT COMMIT REAL SECRETS.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://survey_user:CHANGE_ME_DB_PASSWORD@cps-db:5432/survey_db
POSTGRES_USER=survey_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=survey_db

# ── Secrets ───────────────────────────────────────────────
# openssl rand -hex 32 (three different values)
SURVEY_HASH_SALT=CHANGE_ME_HASH_SALT
SURVEY_DB_ENCRYPTION_KEY=CHANGE_ME_DB_ENC_KEY
SURVEY_JWT_SECRET=CHANGE_ME_JWT_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# ── Mail (leave SMTP_HOST empty → writes .eml to /data/outbox) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Digitradin <no-reply@digitradin.cloud>
OUTBOX_DIR=/data/outbox

# ── Preprod conveniences (MUST be off in production) ──────
# When true, signup/signin responses include the PIN so the flow can be
# tested without real email. Set to false before going live.
EXPOSE_PINS=true

NODE_ENV=production
PORT=3000
