# CPS — preprod environment variables
# Copy to /opt/cps/.env.production and fill in real secrets.
# DO NOT COMMIT REAL SECRETS.

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://survey_user:CHANGE_ME_DB_PASSWORD@cps-db:5432/survey_db
POSTGRES_USER=survey_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=survey_db

# ── Secrets ───────────────────────────────────────────────
# openssl rand -hex 32 (three different values)
SURVEY_HASH_SALT=CHANGE_ME_HASH_SALT
SURVEY_DB_ENCRYPTION_KEY=CHANGE_ME_DB_ENC_KEY
SURVEY_JWT_SECRET=CHANGE_ME_JWT_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# ── Mail (leave SMTP_HOST empty → writes .eml to /data/outbox) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Digitradin <no-reply@digitradin.cloud>
OUTBOX_DIR=/data/outbox

# ── Preprod conveniences (MUST be off in production) ──────
# When true, signup/signin responses include the PIN so the flow can be
# tested without real email. Set to false before going live.
EXPOSE_PINS=true

NODE_ENV=production
PORT=3000

# ── AI for My learning › Plans (all optional — fill in the free keys you have) ──
# Wikigai uses every key below, spreads requests across them and fails over automatically.
AI_ROUTER_URL=https://router.digitradin.cloud
AI_ROUTER_TOKEN=
AI_ROUTER_MODEL=auto
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
SAMBANOVA_API_KEY=
NVIDIA_API_KEY=
OLLAMA_API_KEY=
OLLAMA_MODEL=
# AI_PROVIDER_ORDER=router,groq,gemini   # optional: limit / order providers
# AI_STRATEGY=rotate                     # rotate (default) or ordered
PLAN_DAILY_LIMIT=15
# v20261028: free providers now supported → CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, ZAI_API_KEY
# (Cerebras, GitHub Models and SambaNova are no longer free and were removed — see deploy/AI_RESEARCH_SETUP.md)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ZAI_API_KEY=

# ── Legal identity shown on /privacy and /terms (v20261111b) — Estonian company ──
# Leave LEGAL_REG_CODE / LEGAL_ADDRESS empty until the OÜ is registered: pages then say "being registered in Estonia".
LEGAL_ENTITY_NAME=Digitradin OÜ
LEGAL_REG_CODE=
LEGAL_ADDRESS=
LEGAL_EMAIL=admin@digitradin.cloud

# ── TikTok (v20261112b): "Continue with TikTok" + "Share to TikTok" — Wikigai TikTok app (NOT the Postiz app) ──
# Preprod: the SANDBOX keys + TIKTOK_LOGIN=true / TIKTOK_SHARE=true. Production: keep both false until TikTok's app review
# (login) and Direct Post audit (sharing to everyone) pass. The secret stays on the server only.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# must equal the redirect URI registered in the TikTok app (default: PUBLIC_URL + /auth/tiktok/callback)
TIKTOK_REDIRECT_URI=
# domain verified in the TikTok app — carousel images are served from here (default: PUBLIC_URL)
TIKTOK_MEDIA_BASE_URL=
TIKTOK_LOGIN=false
TIKTOK_SHARE=false

# ── Other sign-in apps (v20261112c) — HIDDEN everywhere (buttons, Account, privacy text) until keys + <APP>_LOGIN=true ──
# Redirect URI to register in each app: PUBLIC_URL + /auth/<app>/callback (google | facebook | instagram). Secrets: server only.
# Google Cloud → OAuth client (Web), scopes openid email profile
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_LOGIN=false
# Meta app for USER sign-in ("Facebook Login") — a separate app from the Postiz publishing app
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
FACEBOOK_GRAPH_VERSION=v21.0
FACEBOOK_LOGIN=false
# Instagram API with Instagram Login (business/creator accounts only; gives no email)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_LOGIN=false
